# Database
# For manual setup, set DATABASE_URL to your PostgreSQL connection string and
# URL-encode reserved characters used inside credentials.
# Generated hex is simplest. For Docker Compose values, single-quote strings
# containing $, #, or other punctuation so Compose preserves them literally.
DATABASE_URL=
POSTGRES_PASSWORD=

# LLM Provider: anthropic, openai, or gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
# LLM_MODEL=  # Optional: auto-selected per provider

# Authentication
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SECRET=

# Docker Compose network binding
MIR_BIND_ADDRESS=127.0.0.1
MIR_PORT=3000

# Scraping (optional — falls back to requests+beautifulsoup)
# FIRECRAWL_API_KEY=

# Enrichment (optional — gracefully skipped if not set)
# APOLLO_API_KEY=
# SALESQL_API_KEY=
